{
  "name": "03 \u00b7 Frontend deployment",
  "operation": "Preview selected Cloudflare deployments",
  "schema": {
    "type": "object",
    "properties": {
      "environment": {
        "type": "string",
        "title": "Environment",
        "enum": [
          "dev",
          "stage",
          "prod"
        ]
      },
      "services": {
        "type": "array",
        "title": "Services to deploy",
        "items": {
          "type": "string",
          "enum": [
            "portal-website",
            "admin-website",
            "docs-website"
          ]
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "version": {
        "type": "string",
        "title": "Version",
        "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "dryRun": {
        "type": "boolean",
        "title": "Dry run"
      }
    },
    "required": [
      "environment",
      "services",
      "version",
      "dryRun"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Group",
        "label": "Target",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/environment"
          },
          {
            "type": "Control",
            "scope": "#/properties/services"
          }
        ]
      },
      {
        "type": "Group",
        "label": "Release",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/version"
          },
          {
            "type": "Control",
            "scope": "#/properties/dryRun"
          }
        ]
      }
    ]
  },
  "data": {
    "environment": "stage",
    "services": [
      "portal-website"
    ],
    "version": "v1.2.3",
    "dryRun": true
  }
}
