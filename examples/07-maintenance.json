{
  "name": "07 · Maintenance window",
  "operation": "Preview a maintenance window",
  "schema": {
    "type": "object",
    "properties": {
      "environment": {
        "type": "string",
        "title": "Environment",
        "enum": [
          "dev",
          "stage",
          "prod"
        ]
      },
      "tasks": {
        "type": "array",
        "title": "Tasks",
        "items": {
          "type": "string",
          "enum": [
            "clear-cache",
            "reindex-search",
            "rotate-logs"
          ]
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "durationMinutes": {
        "type": "integer",
        "title": "Window length (minutes)",
        "minimum": 5,
        "maximum": 120
      },
      "reason": {
        "type": "string",
        "title": "Reason",
        "minLength": 10,
        "maxLength": 200,
        "format": "textarea"
      },
      "scheduledDate": {
        "type": "string",
        "title": "Maintenance date",
        "format": "date"
      },
      "startTime": {
        "type": "string",
        "title": "Start time (UTC)",
        "format": "time",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
      },
      "notifyOwner": {
        "type": "string",
        "title": "Owner email",
        "format": "email",
        "maxLength": 120
      }
    },
    "required": [
      "environment",
      "tasks",
      "durationMinutes",
      "reason",
      "scheduledDate",
      "startTime"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/environment"
      },
      {
        "type": "Control",
        "scope": "#/properties/tasks"
      },
      {
        "type": "Control",
        "scope": "#/properties/durationMinutes"
      },
      {
        "type": "Control",
        "scope": "#/properties/reason"
      },
      {
        "type": "Control",
        "scope": "#/properties/scheduledDate"
      },
      {
        "type": "Control",
        "scope": "#/properties/startTime"
      },
      {
        "type": "Control",
        "scope": "#/properties/notifyOwner"
      }
    ]
  },
  "data": {
    "environment": "stage",
    "tasks": [
      "clear-cache"
    ],
    "durationMinutes": 15,
    "reason": "Scheduled demonstration maintenance",
    "scheduledDate": "2026-11-12",
    "startTime": "02:30:00",
    "notifyOwner": "operator@example.com"
  }
}
