{
  "name": "01 \u00b7 Quick start",
  "operation": "Preview a greeting job",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "minLength": 1,
        "maxLength": 80
      },
      "repetitions": {
        "type": "integer",
        "title": "Repetitions",
        "minimum": 1,
        "maximum": 5
      },
      "enthusiastic": {
        "type": "boolean",
        "title": "Enthusiastic greeting"
      }
    },
    "required": [
      "name",
      "repetitions",
      "enthusiastic"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/name"
      },
      {
        "type": "Control",
        "scope": "#/properties/repetitions"
      },
      {
        "type": "Control",
        "scope": "#/properties/enthusiastic"
      }
    ]
  },
  "data": {
    "name": "GitHub Actions explorer",
    "repetitions": 2,
    "enthusiastic": true
  }
}
