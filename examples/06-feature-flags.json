{
  "name": "06 · Feature flags",
  "operation": "Preview a feature flag rollout",
  "schema": {
    "type": "object",
    "properties": {
      "environment": {
        "type": "string",
        "title": "Environment",
        "enum": [
          "dev",
          "stage",
          "prod"
        ]
      },
      "features": {
        "type": "array",
        "title": "Feature flags",
        "items": {
          "type": "string",
          "enum": [
            "new-navigation",
            "enhanced-search",
            "compact-layout",
            "export-tools"
          ]
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "enabled": {
        "type": "boolean",
        "title": "Enable selected flags",
        "format": "toggle"
      },
      "percentage": {
        "type": "integer",
        "title": "Rollout percentage",
        "minimum": 0,
        "maximum": 100,
        "format": "range"
      }
    },
    "required": [
      "environment",
      "features",
      "enabled",
      "percentage"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/environment"
      },
      {
        "type": "Control",
        "scope": "#/properties/features"
      },
      {
        "type": "Control",
        "scope": "#/properties/enabled"
      },
      {
        "type": "Control",
        "scope": "#/properties/percentage"
      }
    ]
  },
  "data": {
    "environment": "stage",
    "features": [
      "new-navigation",
      "enhanced-search"
    ],
    "enabled": true,
    "percentage": 25
  }
}
